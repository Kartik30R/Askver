# Application Settings
PROJECT_NAME="AskVer API"
API_V1_STR="/api/v1"

# Database Connection (Async PostgreSQL driver via asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/askver_db"

# JWT Configuration
# Generate high-entropy secret keys in production using `openssl rand -hex 32`
JWT_SECRET_KEY="askver_dev_access_secret_key_change_me_in_production_32bytes"
JWT_REFRESH_SECRET_KEY="askver_dev_refresh_secret_key_change_me_in_production_32bytes"
ALGORITHM="HS256"

# Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7